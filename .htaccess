# Private delivery documents are served only after record-level authorization.
RewriteEngine On
RewriteRule ^((?:uploads|delivery_sheets|export)/.*)$ private-file.php?path=$1 [B,L,QSA]
RewriteRule ^(?:includes|scripts|tests|vendor|\.git)(?:/|$) - [F,L]
<FilesMatch "^(db\.php|.*\.(?:sql|zip|log))$">
 Require all denied
</FilesMatch>
# --- serve real files/folders as-is
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- and explicitly exempt /icons/ from app rewrites
RewriteRule ^icons/ - [L]
# Ensure correct MIME types
AddType application/javascript .js
AddType application/json .json
AddType application/manifest+json .webmanifest

# If something upstream forces HTML, override just this file:
<Files "pwa.js">
  ForceType application/javascript
</Files>
